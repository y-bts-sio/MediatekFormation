{% extends "basefront.html.twig" %}
{% block body %}
    <div class="playlist-detail mt-3">
        <h4 class="text-info">{{ playlist.name }}</h4>
        <p>
            <strong>Nombre de formations :</strong> {{ playlist.getFormationCount() }}
        </p>
        <p>
            <strong>Description :</strong><br />
            {{ playlist.description|nl2br }}
        </p>
        <hr />
        <h5>Formations</h5>
        {% if playlistformations|length > 0 %}
            {% for formation in playlistformations %}
                <div class="row mt-1">
                    <div class="col-md-auto">
                        {% if formation.miniature %}
                            <a href="{{ path('formations.showone', {id: formation.id}) }}">
                                <img src="{{ formation.miniature }}" alt="Miniature de la formation {{ formation.title }}" class="img-fluid">
                            </a>
                        {% endif %}
                    </div>
                    <div class="col d-flex align-items-center">
                        <a href="{{ path('formations.showone', {id: formation.id}) }}" class="link-secondary text-decoration-none">
                            {{ formation.title }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p>Aucune formation n'est disponible pour cette playlist.</p>
        {% endif %}
    </div>
{% endblock %}
