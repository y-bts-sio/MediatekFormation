{% extends "basefront.html.twig" %}
{% block body %}
    <table class="table table-striped">
        <caption>Liste des playlists</caption>
        <thead>
            <tr>
                <th class="text-left align-top" scope="col">
                    Playlist<br />
                    <a href="{{ path('playlists.sort', {champ:'name', ordre:'ASC'}) }}" class="btn btn-info btn-sm active" role="button" aria-pressed="true">&lt;</a>
                    <a href="{{ path('playlists.sort', {champ:'name', ordre:'DESC'}) }}" class="btn btn-info btn-sm active" role="button" aria-pressed="true">&gt;</a>
                </th>
                <th class="text-center align-top" scope="col">
                    Nombre de formations<br />
                    <a href="{{ path('playlists.sort', {champ:'formationCount', ordre:'ASC'}) }}" class="btn btn-info btn-sm active" role="button" aria-pressed="true">↑</a>
                    <a href="{{ path('playlists.sort', {champ:'formationCount', ordre:'DESC'}) }}" class="btn btn-info btn-sm active" role="button" aria-pressed="true">↓</a>
                </th>
                <th class="text-center align-top" scope="col">
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            {% if playlists|length > 0 %}
                {% for playlist in playlists %}
                    <tr class="align-middle">
                        <td class="text-left">{{ playlist.name }}</td>
                        <td class="text-center">{{ playlist.getFormationCount() }}</td>
                        <td class="text-center">
                            <a href="{{ path('playlists.showone', {id: playlist.id}) }}" class="btn btn-secondary">
                                Voir détail
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">Aucune playlist trouvée.</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
{% endblock %}