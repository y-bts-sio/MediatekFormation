{% extends 'baseback.html.twig' %}


{% block body %}
<h2>Gestion des Playlists - Back-office</h2>
<a href="{{ path('backoffice_playlists_new') }}" class="btn btn-primary mb-3">Ajouter une playlist</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                Playlist<br>
                <a href="{{ path('backoffice_playlists_sort', {champ:'name', ordre:'ASC'}) }}" class="btn btn-info btn-sm">&lt;</a>
                <a href="{{ path('backoffice_playlists_sort', {champ:'name', ordre:'DESC'}) }}" class="btn btn-info btn-sm">&gt;</a>
                <form method="POST" action="{{ path('backoffice_playlists_findallcontain', {champ:'name', table:'none'}) }}" class="mt-1">
                    <input type="text" name="recherche" class="form-control form-control-sm" value="{{ valeur|default('') }}">
                    <button type="submit" class="btn btn-info btn-sm mt-1">Filtrer</button>
                </form>
            </th>
            <th>
                Nombre de formations<br>
                <a href="{{ path('backoffice_playlists_sort', {champ:'formationCount', ordre:'ASC'}) }}" class="btn btn-info btn-sm">↑</a>
                <a href="{{ path('backoffice_playlists_sort', {champ:'formationCount', ordre:'DESC'}) }}" class="btn btn-info btn-sm">↓</a>
            </th>
            <th>
                Catégories<br>
                <form method="POST" action="{{ path('backoffice_playlists_findallcontain', {champ:'id', table:'categories'}) }}">
                    <select name="recherche" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Toutes</option>
                        {% for categorie in categories %}
                            <option value="{{ categorie.id }}"
                                {% if valeur is defined and valeur == categorie.id %}selected{% endif %}>
                                {{ categorie.name }}
                            </option>
                        {% endfor %}
                    </select>
                </form>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for playlist in playlists %}
            <tr>
                <td>{{ playlist.name }}</td>
                <td>{{ playlist.getFormationCount() }}</td>
                <td>
                    {% for categorie in playlist.getCategoriesPlaylist() %}
                        {{ categorie }}<br>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('backoffice_playlists_edit', {id: playlist.id}) }}" class="btn btn-secondary btn-sm">Modifier</a>
                    <form method="POST" action="{{ path('backoffice_playlists_delete', {id: playlist.id}) }}" style="display:inline-block;" onsubmit="return confirm('Confirmez la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ playlist.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">Aucune playlist trouvée.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
