{# templates/baseback.html.twig #}
{% extends "base.html.twig" %}

{% block title %}Back Office - Mediatek Formation{% endblock %}
{% block stylesheets %}{% endblock %}

{% block top %}
    <div class="container">
        <!-- Bannière -->
        <div class="text-left">
            <img src="{{ app.request.getBasePath() ~ '/banniere.jpg' }}" alt="Bannière du site MediaTek86">
        </div>
        <!-- Menu de navigation backoffice -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mt-3">
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="{{ path('backoffice_formations') }}">Formations</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('backoffice_playlists') }}">Playlists</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('backoffice_categories') }}">Catégories</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">Déconnexion</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </nav>
    </div>
{% endblock %}

{% block body %}{% endblock %}

{% block footer %}
    <div class="container text-center mt-4">
        <hr>
        <footer>
            <p><small><em>Back Office - MediaTekFormation</em></small></p>
        </footer>
    </div>
{% endblock %}

{% block javascripts %}{% endblock %}
